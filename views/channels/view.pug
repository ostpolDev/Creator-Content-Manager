extends ../layout

block content

    .modal#descriptionTemplateModal
        .modalBackground(data-modal="close")
        .modalContainer
            .modalHeader 
                h2 Description Template
                span.close(data-modal="close")
                    i.fas.fa-times
            .modalContent

                .segment Description templates are used to quickly generate a video description. Each channel gets one.

                form(action="/channels/saveDescriptionTemplate/"+channelToView.id, method="post") 
                    .field
                        label.label(for="template") Template
                        .control
                            textarea.textarea#template(name="template", placeholder="Write the description template...", maxlength="5000", rows="15")
                                | #{channelToView.descriptionTemplate.text}

                    .field
                        button.button.is-link
                            span.icon
                                i.fas.fa-save
                            span Save

                .divider.ligth

                p Video description templates can use tokens. Tokens are pieces of text that get replaced with information as the description gets generated from the template.
                    | Use these tokens in your description text to make them more dynamic.
                p
                    | To use a token, sourround the name of the token with curly braces, for example, the token "name" would turn into {name}

                table.table.striped
                    thead
                        th Token
                        th Effect
                    tbody
                        tr
                            td name
                            td The video name
                        tr
                            td starring
                            td A list of users that starr in the video
                        tr
                            td editor
                            td The name of the user that edited this video
                        tr
                            td legal
                            td The legal info required for the assets used in the video
                        tr
                            td date
                            td The current date
                        tr
                            td dictionary
                            td A random word from the dictionary 

                if channelToView.descriptionTemplate.lastUpdate && channelToView.descriptionTemplate.lastUpdateBy
                    p The description template was last updated by 
                        a(href="/users/v/"+channelToView.descriptionTemplate.lastUpdateBy.safeName) #{channelToView.descriptionTemplate.lastUpdateBy.username}
                        |  at #{formatDateAndTime(channelToView.descriptionTemplate.lastUpdate)} 
                else
                    p The description template was never updated
                
            .modalFooter
                button.button.has-icon(data-modal="close")
                    span.icon
                        i.fas.fa-times
                    span Close

    .container
        if channelToView.bannerImageUrl
            .bannerImage(style="background-image: url('" + channelToView.bannerImageUrl + "')")
        .columns
            .column
                .user.fluid.noBorder
                    .image
                        img.rounded(src=channelToView.thumbnails.default.url)
                    .content
                        h1.header
                            if isSelectedChannel
                                span.icon(data-hover=(isSelectedChannel ? "Selected channel" : ""))
                            | #{channelToView.name}
                        if channelToView.customUrl
                            p #{channelToView.customUrl}
                        p #{channelToView.statistics.subscriberCount} #{channelToView.statistics.subscriberCount == 1 ? "subscriber" : "subscribers"}

                br
                
                if channelToView.description
                    .segment
                        pre=channelToView.description
                if videos && videos.length > 0
                    h3.header Lastest videos
                    -let videoGridSize = "oneThird";
                    .columns.multiline
                        include ../videos/videoGrid.pug

                .block
                    h2.header Members (#{1 + channelToView.access.length})
                    a.user.small.fluid(href="/users/v/"+channelToView.createdBy.safeName)
                        .image
                            img.rounded(src="https://www.gravatar.com/avatar/"+channelToView.createdBy.mailHash, alt=channelToView.createdBy.username)
                        .content
                            h1.header #{channelToView.createdBy.username}
                            p Creator of this channel
                                if user && channelToView.createdBy.id == user.id
                                    |  (You)
                    each u, i in channelToView.access
                        a.user.small.fluid(href="/users/v/"+u.safeName)
                            .image
                                img.rounded(src="https://www.gravatar.com/avatar/"+u.mailHash, alt=u.username)
                            .content
                                h1.header #{u.username}

                if channelToView.keywords
                    .block
                        .tags
                            each keyword, i in channelToView.keywords.split(" ")
                                span.tag=keyword
            .column.oneQuarter
                .buttons.fluid
                    if channel.id != channelToView.id
                        button.button#switchChannel(data-channel=channelToView.id)
                            span.icon
                                i.fas.fa-toggle-off
                            span Switch to channel
                    else
                        button.button(disabled data-hover="You are already currently using this cannel")
                            span.icon
                                i.fas.fa-toggle-on
                            span Switch to channel
                    if user && channelToView.createdBy.id == user.id
                        a.button(href="/channels/access/"+channelToView.id)
                            span.icon
                                i.fas.fa-users
                            span Manage Access 
                        button.button(data-modal="#descriptionTemplateModal")
                            span.icon
                                i.fas.fa-pen
                            span Edit description template
                .segment
                    p
                            b Created by:
                            br
                            a(href="/users/v/"+channelToView.createdBy.safeName)=channelToView.createdBy.username 
                    if channelToView.publishedAt
                        p
                                b(data-hover="When this channel was created on YouTube") Created at:
                                br
                                span(title=channelToView.publishedAt.toLocaleString()) #{formatDateAndTime(channelToView.publishedAt)}
                    p
                            b(data-hover="When this channel was added to this site") Added at:
                            br
                            span(title=channelToView.createdAt.toLocaleString()) #{formatDateAndTime(channelToView.createdAt)} 

                    if channelToView.countryInfo && channelToView.countryInfo.name.common
                        p
                            b Country:
                            br
                            span(data-hover=channelToView.countryInfo.name.native.official) #{channelToView.countryInfo.name.common} #{channelToView.countryInfo.flag}
                    else if channelToView.country
                        p
                            b Country:
                            br
                            span #{channelToView.country}
                    p
                        b YouTube ID
                        br
                        span=channelToView.youtubeId
                    each thing, i in Object.keys(channelToView.statistics)
                        p
                            b #{formatString(thing)}:
                            br
                            | #{channelToView.statistics[thing]}

                    if channelToView.meta.requestInfo.lastRequest
                        p
                            b Last Update:
                            br
                            span(title=channelToView.meta.requestInfo.lastRequest.toLocaleString()) #{formatDateAndTime(channelToView.meta.requestInfo.lastRequest)}
                    p
                        b Last Request Duration:
                        br
                        span #{channelToView.meta.requestInfo.time}ms
                    if diffHours
                        p
                            b Hours Since Last Request:
                            br
                            span(title=diffHours data-hover=diffHours) #{diffHours.toFixed(1)}
                    if channelToView.meta.requestInfo.by
                        p
                            b Last Request made by:
                            br
                            a(href="/users/v/"+channelToView.meta.requestInfo.by.safeName)=channelToView.meta.requestInfo.by.username 

                .buttons.fluid
                    a.button(href=channelToView.url target="_BLANK") 
                        span.icon
                            i.fab.fa-youtube
                        span View on YouTube

                    if channelToView.meta.requestInfo.lastRequest
                        -
                            let lastUpdateDiff = new Date().getTime() - channelToView.meta.requestInfo.lastRequest.getTime()
                            let diffHours = lastUpdateDiff / 3.6e+6;
                            let canUpdate = diffHours >= 12;
                            let isSelectedChannel = channelToView.id == channel.id;
                    
                        if canUpdate || !channelToView.meta.requestInfo.lastRequest
                            a.button(href="/channels/update/"+channelToView.id)
                                span.icon
                                    i.fas.fa-sync
                                span Request Update
                        else
                            button.button(disabled title="Only available every 12 hours")
                                span.icon
                                    i.fas.fa-sync
                                span(disabled data-hover="Only available every 12 hours") Request Update 
                    else
                        a.button(href="/channels/update/"+channelToView.id)
                            span.icon
                                i.fas.fa-sync
                            span Request Update


block scripts
    script(src="/js/channelSwitcher.js") 
