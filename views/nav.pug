nav.navbar
    .navContainer 
        .section
            .navButtons
                a.navItem(href="/")
                    span.icon 
                        i.fas.fa-home 
                    span Home

                if user
                    .navItem.dropdown
                        a.navItem.chevron(href="/videos")
                            span.icon
                                i.fas.fa-video
                            span Videos

                        .dropdown
                            a.navItem(href="/videos/add") Add

                .navItem.dropdown
                    a.navItem.chevron(href="/assets") Assets

                    .dropdown
                        if user
                            a.navItem(href="/assets/upload") Upload
                        a.navItem(href="/assets/search") Search
                        a.navItem(href="/assets/batches") Batches
                        a.navItem(href="/assets/batches/albums") Albums
                if user
                    .navItem.dropdown
                        a.navItem.chevron(href="/channels") Channels

                        .dropdown
                            if channel
                                a.navItem(href="/channels/v/"+channel.id) #{channel.name}
                            a.navItem(href="/channels/add") Add
                    
                    a.navItem(href="/users")
                        span.icon 
                            i.fas.fa-users
                        span Users 
                    a.navItem(href="/games")
                            span.icon 
                                i.fas.fa-gamepad
                            span Games
        .section
            .navButtons
                .navItem#changeLightModeButton(style="cursor: pointer;" data-modal="#lightModeModal")
                    span.icon
                        i.fas.fa-sun
                if !user
                    a.navItem.button(href="/users/login") Login 
                    a.navItem.button(href="/users/register")
                        span.icon
                            i.fas.fa-user-plus
                        span Register
                else
                    a.navItem.vertCenter(href="/users/v/"+user.safeName, data-context-name="Settings" data-context-icon="cog" data-context-link="/users/settings"  data-disable-hover="true")
                        if !user.meta.preferences.navUserIcon || user.meta.preferences.navUserIcon == "both" || user.meta.preferences.navUserIcon == "image"
                            span.icon.hasImage
                                img.circle(src="https://www.gravatar.com/avatar/"+user.mailHash+"?s=50", alt="")
                        if !user.meta.preferences.navUserIcon || user.meta.preferences.navUserIcon == "both" || user.meta.preferences.navUserIcon == "name"
                            span.vertCenter(data-context-name="Settings" data-context-icon="cog" data-context-link="/users/settings") #{user.username} 
                    a.navItem.button(href="/users/logout")
                        span.icon
                            i.fas.fa-sign-out-alt
                        span Log out

        .navToggle
            span.icon
                i.fas.fa-bars