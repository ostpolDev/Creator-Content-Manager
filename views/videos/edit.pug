extends ../layout

block content
    .container
        nav.breadcrumb.has-succeeds-separator
            ul
                li
                    a(href="/channels") Channels
                li
                    a(href="/channels/v/" + video.channel_id) #{video.channel_name}
                li
                    a(href="/videos?channel=" + encodeURIComponent(video.channel_id)) Videos
                li
                    a(href="/videos/v/" + video.id) #{video.title || video.id}
                li.is-active
                    a(href="#") Edit 

        h1.title #{video.title}
        p.subtitle Edit

        form(data-form="/api/videos/edit/" + video.id, method="POST")
            .field
                label.label(for="channelSelect" name="channel") Channel
                .control
                    select.input.channelSelect#channelSelect(autocomplete="off" name="channel")
                        each channel in channels
                            option(value=channel.id, selected=(video.channel == channel.id)) #{channel.name} 

            .field
                label.label(for="youtubeId") YouTube video ID or URL
                .control.has-icons-left
                    input.input#youtubeId(type="text" placeholder="R_FQU4KzN7A" name="youtube", value=video.youtube_id) 
                    span.icon.is-small.is-left
                        span videocam
                p.help Either the ID of the video, or a link to a video

            .field
                label.label(for="videoName") Video title
                .control.has-icons-left
                    input.input#videoName(type="text" placeholder="Title of your video" name="title", value=video.title)
                    span.icon.is-small.is-left
                        span title

            -
                const starring = members.filter(x => x.starring == true);
                const editor = members.filter(x => x.editor == true);

            .field(data-search="user")
                label.label(for="starring") Starring
                .control.has-icons-left
                    input.input#starring(type="text" placeholder="Enter a name..." autocomplete="off")
                    input#starringResult(type="hidden" autocomplete="off" value=(JSON.stringify(starring.map(x => x.username))) name="starring")
                    span.icon.is-small.is-left
                        span person

            .field(data-search="user")
                label.label(for="editors") Editors
                .control.has-icons-left
                    input.input#editors(type="text" placeholder="Enter a name..." autocomplete="off")
                    input#editorsResult(type="hidden" autocomplete="off" value=(JSON.stringify(editor.map(x => x.username))) name="editors")
                    span.icon.is-small.is-left
                        span person

            button.button.is-fullwidth.is-link
                span.icon
                    span save
                span Save changes
