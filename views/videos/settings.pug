extends ../layout

block content

    .modal#confirmDeleteModal
        .modalBackground(data-modal="close")
        .modalContainer
            .modalHeader 
                h2 Are you sure?
                span.close(data-modal="close")
                    i.fas.fa-times 
            .modalContent
                p This will remove the video titled 
                    strong "#{video.title}"
                    |  from this site. This cannot be undone. The video can however be re-added later.
                p Keep in mind, that you can also 
                    a(href="/videos/settings/"+video.id+"/change channel") move this video to another channel. 
            .modalFooter
                button.button.has-icon.danger#deleteVideoButton
                    span.icon
                        i.fas.fa-trash
                    span Confirm
                button.button.has-icon(data-modal="close")
                    span.icon
                        i.fas.fa-times
                    span Cancel

    .container 
        h1.header #{video.title}
        p.subtitle 
            span.capitalized #{setting}
            |  Settings

        .columns
            .column.oneQuarter
                nav.sideMenu
                    h1.menuHeader Categories
                    ul
                        each s, i in settings
                            li(class=(s == setting ? "active" : ""))
                                a.capitalized(href="/videos/settings/"+ video.id +"/"+encodeURIComponent(s))=s 
                .buttons.fluid
                    a.button(href="/videos/v/"+encodeURIComponent(video.id))
                        span.icon
                            i.fas.fa-arrow-left
                        span Back 
            .column
                h2.title #{capitalize(setting)}
                .divider.light
                if setting == "general"
                    include settings/general.pug
                else if setting == "change channel"
                    include settings/move.pug
                else if setting == "assets"
                    include settings/assets.pug
                else if setting == "games"
                    include settings/games.pug
                else
                    .message.danger
                        .messageHeader You shouldn't be able to see this.
                        .messageBody
                            p If you can see this, something went wrong. Please tell someone about this.
                            .segment.noBackground
                                pre=JSON.stringify(settings, null, "\t")
                                p=setting

block scripts
    script.
        const currentVideo = "#{video.id}";
        const currentChannel = "#{video.channel.id}";

    if setting == "change channel"
        script(src="/js/videoChannelSwitcher.js")
    if setting == "assets"
        script(src="/js/videoAssetManager.js") 
    if setting == "games"
        script(src="/js/videoGameManager.js") 

    script.
        const deleteVideoButton = document.getElementById("deleteVideoButton");
        deleteVideoButton.addEventListener("click", () => {
            fetch("/api/videos/delete/"+encodeURIComponent("#{video.id}"), {
                method: "POST"
            }).then((res) => {return res.json()}).then((json) => {
                if (json.success === true) {
                    window.location = "/videos"
                } else {
                    console.error(json.msg);
                }
            }).catch((err) => {
                console.error(err);
            })
        })