extends ../layout

block content
    .modal#legalInfoModal
        .modalBackground(data-modal="close")
        .modalContainer
            .modalHeader 
                h2 Legal Information
                span.close(data-modal="close")
                    i.fas.fa-times
            .modalContent
                p Put this into the videos description to not get a copy-right claim.
                pre#legalInfoContent
            .modalFooter
                button.button.has-icon(data-modal="close")
                    span.icon
                        i.fas.fa-times
                    span Close
    -let lastUpdateDiff = new Date().getTime() - video.meta.requestInfo.lastRequest.getTime()
    -let diffHours = lastUpdateDiff / 3.6e+6;
    -let canUpdate = diffHours >= 2;
    .container 
        .buttons
            a.button(href="/videos") 
                span.icon
                    i.fas.fa-arrow-left
                span Back
        h1.header #{video.title}
            if !video.isEmpty
                if video.status.privacyStatus == "unlisted"
                    span.icon.right
                        i.fas.fa-eye
                else if video.status.privacyStatus == "private"
                    span.icon.right
                        i.fas.fa-eye-slash
        p.subtitle #{video.channel.name}
            if !video.isEmpty
                |  | Uploaded #{formatDate(video.meta.publishedAt)}
            else
                |  | Added #{formatDateAndTime(video.createdAt)}
        if !video.isEmpty
            .block
                p
                if video.meta.starringString
                    span Starring #{video.meta.starringString} | 
                if video.meta.editorsString
                    span Edited by #{video.meta.editorsString}

        .columns
            .column
                if video.isEmpty
                    .message.info
                        .messageHeader Empty Video
                        .messageBody
                            p This video is empty, meaning it does not contain any YouTube information. To change this, go into the video settings and add a YouTube Video ID.
                else
                    iframe(style="width:100%; aspect-ratio: 16 / 9;" src="https://www.youtube-nocookie.com/embed/"+video.youtubeId title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen)
                    p
                        span.icon
                            i.fas.fa-eye
                        span #{numberWithCommas(video.statistics.viewCount)} views | 
                        span.icon
                            i.fas.fa-thumbs-up
                        span #{numberWithCommas(video.statistics.likeCount)} likes | 
                        span.icon
                            i.fas.fa-comment
                        span #{numberWithCommas(video.statistics.commentCount)} comments
                    .divider
                    if video.description
                        .segment
                            pre!=replace_content(video.description)
                    if video.youtubeTags
                        .tags
                            each tag, i in video.youtubeTags
                                span.tag #{tag}

                    if assets && assets.length > 0
                        br
                        h2.header Assets (#{assets.length})
                        .buttons
                            if user && user.id == video.createdBy.id
                                a.button(href="/videos/settings/"+video.id+"/assets")
                                    span.icon
                                        i.fas.fa-file-circle-check 
                                    span Manage assets 
                            button.button#viewLegalInfoButtons
                                span.icon
                                    i.fas.fa-file-contract
                                span View legal information
                        table.table.striped.hoverable
                            thead 
                                th Action
                                th Name
                                th Uploader
                                th Tags
                            tbody#assetTableBody
                                include ../assets/assetList.pug
            .column.oneQuarter
                if !video.isEmpty
                    .buttons.fluid
                        a.button(href=video.url target="_BLANK")
                            span.icon
                                i.fab.fa-youtube
                            span View on YouTube 
                        if video.createdBy.id == user.id
                            a.button(href="/videos/settings/"+video.id)
                                span.icon
                                    i.fas.fa-cog
                                span Settings
                
                .segment
                    each thing, i in Object.keys(video.statistics)
                        if video.statistics[thing]
                            p
                                b #{formatString(thing)}:
                                br
                                -
                                    let _thing = video.statistics[thing];
                                    let type = typeof(_thing);
                                span(title=_thing)
                                    if type == "number" || !isNaN(_thing)
                                        | #{numberWithCommas(_thing)}
                                    else if type == "string"
                                        | #{formatString(_thing)}
                                    else if type == "boolean"
                                        | #{formatBoolean(_thing)}
                    
                    each thing, i in Object.keys(video.status)
                        if video.status[thing]
                            p
                                b #{formatString(thing)}:
                                br
                                -
                                    let _thing = video.status[thing];
                                    let type = typeof(_thing);
                                span(title=_thing)
                                    if type == "number"
                                        | #{numberWithCommas(_thing)}
                                    else if type == "string"
                                        | #{formatString(_thing)}
                                    else if type == "boolean"
                                        | #{formatBoolean(_thing)}
                    if !video.isEmpty
                        .divider
                        p
                            b Last Update:
                            br
                            span(title=video.meta.requestInfo.lastRequest.toLocaleString()) #{formatDateAndTime(video.meta.requestInfo.lastRequest)}
                        p
                            b Last Request Duration:
                            br
                            span #{video.meta.requestInfo.time}ms
                        p
                            b Hours Since Last Request:
                            br
                            span(title=diffHours data-hover=diffHours) #{diffHours.toFixed(1)}

                if !video.isEmpty
                    if canUpdate
                        a.button.fluid(href="/videos/update/"+video.id)
                            span.icon
                                i.fas.fa-sync
                            span Request Update
                    else
                        button.button.fluid(disabled title="Only available every 12 hours")
                            span.icon
                                i.fas.fa-sync
                            span(disabled data-hover="Only available every 12 hours") Request Update 

block scripts
    script.
        const VIDEO_ID = "#{video.id}";
    script(src="/js/videoLegalModal.js")
