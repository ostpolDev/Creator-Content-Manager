if backendRender && backendRender === true
    include ../misc/functions.pug

each video, i in videos
    .column(class=(videoGridSize ? videoGridSize : "oneQuarter"))
        a.card.hoverable(href="/videos/v/"+video.id)
            if !video.isEmpty
                .cardImage
                    img(src=video.thumbnails.medium.url, alt=video.title, loading="lazy") 
            .cardBody
                h1.header #{video.title}
                    if video.status.privacyStatus == "unlisted"
                        span.icon.right
                            i.fas.fa-eye
                    else if video.status.privacyStatus == "private"
                        span.icon.right
                            i.fas.fa-eye-slash
                -let fieldValue;
                if field
                    -fieldValue = getObjectByString(video, field);
                p
                    if field && fieldValue && (field != "title" && field != "createdAt" && field != "meta.publishedAt" && field != "statistics.viewCount")
                        | #{currentSort}: #{fieldValue}
                        br
                    if !video.isEmpty
                        | #{numberWithCommas(video.statistics.viewCount)} views
                        br
                        | Edited by #{video.meta.editorsString}
                        br
                        | Starring #{video.meta.starringString}
                .meta
                    if video.isEmpty
                        p(title=video.createdAt.toLocaleString()) Added #{formatDate(video.createdAt)}
                    else
                        p(title=video.meta.publishedAt.toLocaleString()) Uploaded #{formatDate(video.meta.publishedAt)}

if !videos || videos.length <= 0
    h3.header No videos found