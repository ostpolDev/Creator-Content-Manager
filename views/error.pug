extends layout

block content
    .container
        h1.title Something went wrong
        p.subtitle Sorry for the inconvenience

        .content.block
            p Something went wrong trying to load this page. Please try again later.
            p If this problem persists, please contact the site adminstrator with the following error code:

            .notification
                p=id
                if errorURL
                    p=errorURL

        a.button.is-link
            span.icon
                span home
            span Back home
