doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(http-equiv="X-UA-Compatible", content="IE=edge")
        meta(name="viewport", content="width=device-width, initial-scale=1.0, user-scalable=no")

        link(rel="stylesheet", href="/css/styles.css")
        if colorMode == "Auto"
            link(rel="stylesheet", href="/css/styles.auto.css")
        else if colorMode == "Dark"
            link(rel="stylesheet", href="/css/styles.dark.css")
        link(rel="stylesheet", href="/css/normalize.css")

        link(rel="stylesheet", href="/fontawesome/css/all.min.css")
        script(src="/fontawesome/js/all.min.js") 

        title #{title? title + " | ":""}Creator Content Manager 

        block head
    body

        .contextMenu#contextMenu
            h1.menuHeader#specificDivider Quick Action
            .contextList#contextSpecific
            h1.menuHeader Context
            .contextList#contextSpecific
                a.item(href="/")
                    span.icon
                        i.fas.fa-home
                    span Home 

        .modal#lightModeModal
            .modalBackground(data-modal="close")
            .modalContainer
                .modalHeader 
                    h2 Change Site Display
                    span.close(data-modal="close")
                        i.fas.fa-times
                .modalContent
                    .buttons.fluid
                        each mode, i in colorModes
                            a.button(onclick="setTheme('"+mode+"')") #{mode} 
                .modalFooter
                    button.button.has-icon(data-modal="close")
                        span.icon
                            i.fas.fa-times
                        span Close

        .modal.image#mediaModal
            .modalBackground(data-modal="close")
            .modalContainer
                img.rounded.hidden#mediaModalImage
                video.hidden.rounded(controls, autoplay)#mediaModalVideo 
                .modalFooter
                    h1#mediaModalName
                    .buttons
                        button.button.hasIcon(data-modal="close")
                            span.icon
                                i.fas.fa-times
                            span Close
                        a.button.hasIcon#mediaModalViewButton
                            span.icon
                                i.fas.fa-eye
                            span View

        #musicPlayer.musicPlayer.active
            .playerContainer
                .previewImage
                    a(href="")#playerImageLink
                        img#musicPlayerImage
                .playerControlsContainer
                    p.playerSongName
                        a#playerLink
                            span#playerSongTitle
                            span#playerArtist.playerArtist
                    .playerControls
                        span#musicPlayerTime 00:00
                        input#musicPlayerProgress.playerProgress(type="range" min="0" max="0" value="0")
                        span#musicPlayerTotalTime 00:00
                    .playerButtons
                        .buttonContainer
                            button#musicPlayerPause.button.rounded.iconButton(data-hover="Pause / Resume")
                                #playerPauseIcon
                                    i.fas.fa-pause
                                #playerPlayIcon.hidden
                                    i.fas.fa-play
                            button#musicPlayerReplay.button.rounded.iconButton(data-hover="Replay")
                                i.fas.fa-redo
                            a#musicPlayerLink.button.rounded.iconButton(data-hover="Go to asset")
                                i.fas.fa-eye
                            button#musicPlayerClose.button.rounded.iconButton(data-hover="Close")
                                i.fas.fa-times

        .hoverTag#hoverTag
            span#hoverTagText


        include misc/functions.pug

        section
            include nav.pug

        section
            .container
                != messages('misc/message', locals)
                if back
                    a.button(href=back)
                        span.icon
                            i.fas.fa-arrow-left
                        span Back 
            block content

        if environment == "development"
            section
                .container
                    small
                        span.icon(title="This site is running in development mode")
                            i.fas.fa-tools
                        span This site is running in 
                            strong #{environment} 
                            |  mode.

        script(src="/js/navbar.js")
        script(src="/js/fileInputs.js")
        script(src="/js/modal.js")
        script(src="/js/hover.js")  
        script(src="/js/themeSwitcher.js") 
        script(src="/js/musicPlayer.js") 

        script(src="/js/assetFunctions.js") 
        script(src="/js/contextMenu.js") 

        block scripts
