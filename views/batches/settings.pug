extends ../layout

block head
    if !user.meta.preferences.disableMarkdown
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css")
        script(src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js") 

block content
    .container

        .buttons
            a.button(href="/assets/batches/v/"+batch.id)    
                span.icon
                    i.fas.fa-arrow-left
                span Back 

        h1.header #{batch.name}
        p.subtitle #{title}

        .segment
            form(action="/assets/batches/save/"+batch.id, method="post") 
                .field.required
                    label.label(for="batchName") Batch Name
                    .control.hasIcon
                        input.input#batchName(type="text", name="batchName", placeholder="Album by Person", maxlength="256", autocomplete="off", value=batch.name, required)
                        span.icon
                            i.fas.fa-folder

                .field
                    label.label(for="aboutText") About
                    .control
                        textarea.textarea#aboutText(type="text", name="about", placeholder="About the batch...", autocomplete="off")
                            | #{batch.customInfo.description.raw}

                .field
                    label.label(for="artist") Artist
                    .control.hasIcon
                        input.input#artist(type="text", name="artist", placeholder="Person Name", maxlength="256", autocomplete="off", value=batch.artist)
                        span.icon
                            i.fas.fa-user

                .field
                    label.label(for="price") Price
                    .control.hasIcon
                        input.input#price(type="number" name="price" min=0 step=0.01 placeholder="7.99" value=batch.purchase.price)
                        span.icon
                            i.fas.fa-money-bill-alt

                .field
                    div.checkbox
                        input.checkbox#album(type="checkbox" name="album" checked=batch.isAlbum)
                        label(for="album") This batch is an album

                .field
                    div.checkbox
                        input.checkbox#hasNoArtist(type="checkbox" name="hasNoArtist" checked=batch.hasNoArtist)
                        label(for="hasNoArtist") This batch does not have an artist

                .field
                    div.checkbox(disabled=batch.containsNSFW data-hover=(batch.containsNSFW ? "If one or more assets within this batch have been marked as NSFW, the batches NSFW setting cannot be disabled." : ""))
                        input.checkbox#nsfw(type="checkbox" name="nsfw" checked=batch.nsfw disabled=batch.containsNSFW)
                        label(for="nsfw" title="Not safe for work") NSFW


                .field
                    button.button.success.fluid
                        span.icon
                            i.fas.fa-save
                        span Save
        .divider.light
        p
            small * Required

block scripts
    if !user.meta.preferences.disableMarkdown
        script.
            const easyMDE = new EasyMDE({element: document.getElementById("aboutText")});