extends ../layout

block content
    .modal#confirmBatchDelete
        .modalBackground(data-modal="close")
        .modalContainer
            .modalHeader 
                h2 Are you sure?
                span.close(data-modal="close")
                    i.fas.fa-times 
            .modalContent
                p This will remove the batch named 
                    strong "#{batch.name}"
                    |  from this site. This cannot be undone.

                p All assets within this batch will be removed from this server.
            .modalFooter
                button.button.has-icon.danger#deleteBatchButton
                    span.icon
                        i.fas.fa-trash
                    span Confirm
                button.button.has-icon(data-modal="close")
                    span.icon
                        i.fas.fa-times
                    span Cancel
    .container
        h1.header #{batch.name}
        p.subtitle #{batch.length} assets in batch

        .columns
            .column.threeQuarter
                .segment#descriptionSegment
                    if batch.customInfo.hasCustomInfo
                        pre!=batch.customInfo.description.rendered
                    else if firstAsset && firstAsset.description.rendered
                        pre!=firstAsset.description.rendered.trim()

                #searchContainer(class=(batch.length > 1 ? "" : "hidden"))
                    .field 
                        label.label(for="sortSelect") Sort by
                        .control
                            select.input.capitalized#sortSelect
                                each sort, i in Object.keys(sorts)
                                    option.capitalized(value=sort,selected=(sort == "name date"))=sort

                    .field 
                        label.label(for="channelSelect") Order
                        .control
                            select.input#orderSelect
                                option(value=1 selected) Acending
                                option(value=-1) Decending

                    .field
                        label.label(for="searchQuery") Search Query
                        .control.hasIcon
                            input.input#searchQuery(type="url" name="searchQuery" placeholder="Title, description, tags, ...") 
                            span.icon
                                i.fas.fa-search

                    .field
                        .buttons.equal
                            button.button.fluid#clearButton
                                span.icon
                                    i.fas.fa-trash
                                span Clear Filter
                            button.button.fluid#searchButton
                                span.icon
                                    i.fas.fa-search
                                span Search

                    .divider

                table.table.striped.hoverable
                    thead 
                        th Action
                        th Name
                        th Uploader
                        th Date
                        th Tags
                    tbody#assetTableBody

                button.button.link.fluid.hidden#loadMoreButton
                    span.icon
                        i.fas.fa-plus
                    span Load More

            .column
                .buttons.fluid
                    if user && user.id == batch.createdBy.id
                        a.button(href="/assets/batches/settings/"+batch.id)
                            span.icon
                                i.fas.fa-cog
                            span Settings

                        button.button.danger(data-modal="#confirmBatchDelete")
                            span.icon
                                i.fas.fa-trash
                            span Delete

                    if firstAsset && firstAsset.source
                        a.button(href=firstAsset.source target="_BLANK")
                            span.icon
                                i.fas.fa-globe
                            span View Source 

                    a.user.small.fluid(href="/users/v/"+batch.createdBy.safeName)
                        .image
                            img.rounded(src="https://www.gravatar.com/avatar/"+batch.createdBy.mailHash, alt=batch.createdBy.username)
                        .content
                            h1.header #{batch.createdBy.username}
                            p Creator of this batch

                    .segment
                        p
                            b Created at:
                            br
                            span(title=batch.createdAt.toLocaleString()) #{formatDate(batch.createdAt)} 
                        p
                            b Failed files:
                            br
                            span #{batch.skipped.length}
                        p
                            b Total Size:
                            br
                            span(title=batch.fileSize) #{bytesToSize(batch.fileSize)}

                        p
                            b Upload duration:
                            br
                            span #{batch.uploadTime.time}ms

                if firstAsset.licence && firstAsset.licence != "None"
                    -let licence = licenceTypes[firstAsset.licence]
                    h2.header Licence
                    a.user.tiny.noBorder(href=licence.url target="_BLANK")
                        .image.auto
                            img(src=licence.icon, alt=firstAsset.licence)
                        .content
                            h1.header #{firstAsset.licence}


block scripts
    script.
        const currentBatch = "#{batch.id}";
    script(src="/js/batch.js") 
    script(src="/js/assetList.js") 