extends ../layout

block content
    .container
        h1.header #{batch.name}
        p.subtitle Asset batch

        .columns
            .column.threeQuarter
                .segment#descriptionSegment
                    if batch.customInfo.hasCustomInfo
                        pre!=batch.customInfo.description.rendered
                    else if firstAsset && firstAsset.description.rendered
                        pre!=firstAsset.description.rendered.trim()
                .segment Work in progress...

                .field 
                    label.label(for="channelSelect") Sort by
                    .control
                        select.input.capitalized#sortSelect
                            each sort, i in Object.keys(sorts)
                                option.capitalized(value=sort,selected=(sort == "name date"))=sort

                .field 
                    label.label(for="channelSelect") Order
                    .control
                        select.input#orderSelect
                            option(value=1) Acending
                            option(value=-1 selected) Decending

                .field
                    label.label(for="searchQuery") Search Query
                    .control.hasIcon
                        input.input#searchQuery(type="url" name="searchQuery" placeholder="Title, description, tags, ...") 
                        span.icon
                            i.fas.fa-search

                .field
                    .buttons.equal
                        button.button.fluid#clearButton
                            span.icon
                                i.fas.fa-trash
                            span Clear Filter
                        button.button.fluid#searchButton
                            span.icon
                                i.fas.fa-search
                            span Search

                .divider

                table.table.striped.hoverable
                    thead 
                        th Action
                        th Name
                        th Uploader
                        th Date
                        th Tags
                    tbody#assetTableBody

                button.button.link.fluid.hidden#loadMoreButton
                    span.icon
                        i.fas.fa-plus
                    span Load More

            .column
                .buttons.fluid
                    if user && user.id == batch.createdBy.id
                        a.button(href="/assets/batches/settings/"+batch.id)
                            span.icon
                                i.fas.fa-cog
                            span Settings

                    if firstAsset && firstAsset.source
                        a.button(href=firstAsset.source target="_BLANK")
                            span.icon
                                i.fas.fa-globe
                            span View Source 

                    a.user.small.fluid(href="/users/v/"+batch.createdBy.safeName)
                        .image
                            img.rounded(src="https://www.gravatar.com/avatar/"+batch.createdBy.mailHash, alt=batch.createdBy.username)
                        .content
                            h1.header #{batch.createdBy.username}
                            p Creator of this batch

block scripts
    script.
        const currentBatch = "#{batch.id}";
    //- script(src="/js/batch.js") 
    script(src="/js/assetList.js") 