extends ../layout

block content
    if missingCovers && missingCovers.length > 0
        .modal#missingModal
            .modalBackground(data-modal="close")
            .modalContainer
                .modalHeader 
                    h2 #{missingCovers.length == 1 ? "This batch is" : "These batches are"} missing a cover image.
                    span.close(data-modal="close")
                        i.fas.fa-times
                .modalContent
                    each b, i in missingCovers
                        .notification
                            a.hiddenLink(href="/assets/batches/v/"+b._id)=b.name
                .modalFooter
                    button.button.has-icon(data-modal="close")
                        span.icon
                            i.fas.fa-times
                        span Close

    .container
        h1.header #{type == "batches" ? "Batches" : "Albums"}

        if missingCovers && missingCovers.length > 0
            .message.info.block
                .messageHeader
                    p Info
                .messageBody
                    p #{missingCovers.length} album#{missingCovers.length != 1 ? "s are" : " is"} missing a cover image. 
                        a(href="javascript:void(0);" data-modal="#missingModal") View.

        .field 
            label.label(for="sortSelect") Sort by
            .control
                select.input.capitalized#sortSelect
                    each sort, i in Object.keys(sorts)
                        option.capitalized(value=sort,selected=(sort == "name"))=sort

        .field 
            label.label(for="channelSelect") Order
            .control
                select.input#orderSelect
                    option(value=1 selected) Acending
                    option(value=-1) Decending

        .field
            label.label(for="searchQuery") Search Query
            .control.hasIcon
                input.input#searchQuery(type="url" name="searchQuery" placeholder="Title, description, tags, ...") 
                span.icon
                    i.fas.fa-search

        .field
            .buttons.equal
                button.button.fluid#clearButton
                    span.icon
                        i.fas.fa-trash
                    span Clear Filter
                button.button.fluid#searchButton
                    span.icon
                        i.fas.fa-search
                    span Search

        #batchContainer.hidden

            table.table.striped.hoverable
                thead 
                    th Action
                    th Name
                    th Uploader
                    th Date
                tbody#batchTableBody

        #albumContainer.hidden
            .columns.multiline#batchColumnBody

        button.button.link.fluid.hidden#loadMoreButton
            span.icon
                i.fas.fa-plus
            span Load More

block scripts
    script.
        const TYPE = "#{type}";
    script(src="/js/batchList.js") 