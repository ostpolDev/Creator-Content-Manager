extends layout

block content
    .container
        h1.title Creator Content Manager
        p.subtitle Welcome #{user.name}! This is your overview.
            if channel && channel.name
                span  Your currently using the channel 
                    strong 
                        a.hiddenLink(href="/channels/v/"+channel.id) #{channel.name}
                    | .

        .emptySpace

        if user.meta.preferences.mainPage.randomTip && hint
            .segment
                p
                    strong Tip: 
                    | #{hint}

        if user.meta.preferences.mainPage.showVideos && videos && videos.length > 0
            h2.header Latest videos
            p.subtitle #{videos.length} latest videos across all of your channels
            .columns.multiline
                include videos/videoGrid.pug

        if albums && user.meta.preferences.mainPage.showAlbums && albums.length > 0

            .emptySpace

            h2.header Recent albums
            p.subtitle The #{albums.length != 4 ? albums.length : "4"} most recent albums added

            .columns.multiline
                each album, i in albums
                    .column.oneQuarter
                        a.card.hoverable(href="/assets/batches/v/"+album.id)
                            .cardImage
                                img(src="/assets/batches/cover/"+album.id, loading="lazy")
                            .cardBody 
                                h1.header #{album.name}
                                p #{album.length} songs 

            .emptySpace

        if user.meta.preferences.mainPage.showAssets && assets && assets.length > 0
            h2.header Recent assets
            p.subtitle The 10 most recent assets uploaded

            table.table.striped.hoverable
                thead 
                    th Action
                    th Name
                    th Uploader
                    th Tags
                tbody
                    include assets/assetList.pug
        
        .emptySpace 
        .divider.light

        p
            strong Tip: 
            | Change what's shown here in your 
            a(href="/users/settings/preferences") preference settings