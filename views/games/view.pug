extends ../layout

block content
    .container

        nav.breadcrumb.has-succeeds-separator
            ul
                li
                    a(href="/games") Games
                li.is-active
                    a(href="#") #{title}

        h1.title #{title}
        p.subtitle
            if game.developer
                span Developed by #{game.developer}
            if game.publisher
                if game.developer
                    | , 
                span Published by #{game.publisher}

            .buttons.block
                if game.added_by == user.id
                    if !game.steam_id
                        a.button(href=("/games?focus=add&ref=" + encodeURIComponent(game.id))) 
                            span.icon
                                span settings
                            span Edit game
                    else
                        a.button#refreshButton(href="javascript:void(0);")
                            span.icon
                                span refresh
                            span Refresh 
                if game.website
                    a.button(href=game.website, target="_BLANK")
                        span.icon
                            span link
                        span Official website 

        .block
            if game.description
                pre.noBackground
                    .content!=game.description

        h2.title.is-4 Videos
        
        .block
            .field
                label.label Search
                .control.has-icons-left
                    input.input#searchInput(type="text" placeholder="Search..." name="q", data-list-target="videos", data-list-filter="q")
                    span.icon.is-small.is-left
                        span search

        .columns.is-multiline(data-list="videos" data-list-limit="10", data-list-load="true", data-list-filter=("game:" + encodeURIComponent(game.id)))
            
