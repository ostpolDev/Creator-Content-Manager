extends ../layout

block content
    .container
        h1.header #{users.length} users

        .columns.multiline
            each u, i in users
                .column.oneQuarter
                    a.card.hoverable.circular(href="/users/v/"+u.safeName data-disable-hover="true")
                        .cardImage
                            img(src="https://www.gravatar.com/avatar/"+u.mailHash+"?s=200", alt=u.username)
                        .cardBody.centerText
                            h1.header #{u.username}
                            .meta
                                p Member since 
                                    span(title=u.createdAt.toLocaleString()) #{formatDate(u.createdAt)}