form(action="/users/settings/save/preferences", method="post") 
    .segment.noBackground
        h2.header Main Page Preferences
        .field
            div.checkbox
                input.checkbox#showVideos(type="checkbox" name="showVideos" checked=user.meta.preferences.mainPage.showVideos)
                label(for="showVideos") Show Videos
        .field
            div.checkbox
                input.checkbox#showAssets(type="checkbox" name="showAssets" checked=user.meta.preferences.mainPage.showAssets)
                label(for="showAssets") Show recent Assets
    
        .divider.light

        h3.header Other
        .field
            div.checkbox
                input.checkbox#randomTip(type="checkbox" name="randomTip" checked=user.meta.preferences.mainPage.randomTip)
                label(for="randomTip") Show random hints & tips

    .segment.noBackground
        h2.header Various Preferences
        .field
            div.checkbox
                input.checkbox#hiddenFavorites(type="checkbox" name="hiddenFavorites" checked=user.meta.preferences.hiddenFavorites)
                label(for="hiddenFavorites") Hidden favorites
            p.help Make your favorite assets hidden to other users
        .field
            div.checkbox
                input.checkbox#disableMarkdown(type="checkbox" name="disableMarkdown" checked=user.meta.preferences.disableMarkdown)
                label(for="disableMarkdown") Disable markdown
            p.help Disable markdown fields and instead display the default input field
        .field
            div.checkbox
                input.checkbox#ampm(type="checkbox" name="ampm" checked=user.meta.preferences.ampm)
                label(for="ampm") 12-hour time format
            p.help Whenever time is displayed, do it in the 12-hour format instead.
                br
                | Current: 
                strong #{formatDateAndTime(new Date())}

        .field
            div.checkbox
                input.checkbox#autoplay(type="checkbox" name="autoplay" checked=user.meta.preferences.autoplay)
                label(for="autoplay") Autoplay assets
            p.help When viewing an asset, automatically play it

        .field
            div.checkbox
                input.checkbox#hideAssetVideoList(type="checkbox" name="hideAssetVideoList" checked=user.meta.preferences.hideAssetVideoList)
                label(for="hideAssetVideoList") Hide asset video list
            p.help When viewing assets, there is a list of videos that include the viewed asset. Check this to disable that.

        .field
            div.checkbox
                input.checkbox#showGameDescriptions(type="checkbox" name="showGameDescriptions" checked=user.meta.preferences.showGameDescriptions)
                label(for="showGameDescriptions") Show game descriptions
            p.help Show short descriptions for games in the game list

    .segment.noBackground
        h2.header Defaults
        .field
            label.label(for="defaultChannelSelect") Default Channel
            .control
                select#defaultChannelSelect.input(name="defaultChannel")
                    option(value=undefined) None
            p.help When you login, which channel should automatically be selected

    .emptySpace

    .field
        button.button
            span.icon
                i.fas.fa-save
            span Save settings