extends ../layout

block content
    .container
        h1.title Login

        form.block(action="/api/users/login", method="post") 
            .field
                label.label Username *
                .control.has-icons-left
                    input.input(type="text" name="username" placeholder="Username" required)
                    span.icon.is-small.is-left
                        span person
            .field
                label.label Password *
                .control.has-icons-left
                    input.input(type="password" name="password" placeholder="Password" required)
                    span.icon.is-small.is-left
                        span password

            button.button.is-link Login

        p 
            a(href="/users/register") Need an account?
        br
        p
            small * Required
