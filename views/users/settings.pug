extends ../layout

block head
    if !user.meta.preferences.disableMarkdown
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css")
        script(src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js") 

block content
    .container
        h1.header #{user.username}
        p.subtitle 
            span.capitalized #{setting}
            |  Settings

        .columns
            .column.oneQuarter
                nav.sideMenu
                    h1.menuHeader Categories
                    ul
                        each s, i in settings
                            li(class=(s == setting ? "active" : ""))
                                a.capitalized(href="/users/settings/"+encodeURIComponent(s))=s 
                .buttons.fluid
                    a.button(href="/users/v/"+encodeURIComponent(user.safeName))
                        span.icon
                            i.fas.fa-arrow-left
                        span Back 

                if user.meta.lastRename && user.meta.lastRename.when
                    .segment
                        p
                            b Last Rename:
                            br
                            span(title=user.meta.lastRename.when.toLocaleString()) #{formatDateAndTime(user.meta.lastRename.when)} (#{formatAgo(user.meta.lastRename.when)})
                        p
                            b From:
                            br
                            | #{user.meta.lastRename.from}
                        p
                            b To:
                            br
                            | #{user.meta.lastRename.to}
            .column
                if setting == "general"
                    include settings/general.pug
                else if setting == "email"
                    include settings/email.pug
                else if setting == "password"
                    include settings/password.pug
                else if setting == "preferences"
                    include settings/preferences.pug
                else
                    .message.danger
                        .messageHeader You shouldn't be able to see this.
                        .messageBody
                            p If you can see this, something went wrong. Please tell someone about this.
                            .segment.noBackground
                                pre=JSON.stringify(settings, null, "\t")
                                p=setting

block scripts
    if setting == "general" && (user && !user.meta.preferences.disableMarkdown)
        script.
            const easyMDE = new EasyMDE();

    if setting == "preferences"
        script.
            async function loadChannels() {
                let res = await fetch("/api/channels/getWithAccess");
                let json = await res.json();

                if (!json.success) {
                    console.error(json.msg || "Something went wrong...");
                    return;
                }

                let channelSelect = document.querySelector("#defaultChannelSelect");
                let current = "#{user.meta.preferences.defaultChannel}";

                json.channels.forEach(channel => {
                    channelSelect.innerHTML += `<option value="${channel._id}" ${channel._id == current ? "selected" : ""}>${channel.name} (${channel.customUrl ? channel.customUrl : ""})</option>`;
                })
            }

            loadChannels();