extends ../layout

block head
    if !user.meta.preferences.disableMarkdown
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css")
        script(src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js") 

block content
    .modal#uploadHelpModal
        .modalBackground(data-modal="close")
        .modalContainer
            .modalHeader 
                h2 Help and information
                span.close(data-modal="close")
                    i.fas.fa-times
            .modalContent
                h2.header Files
                p At least one file has to be uploaded. When a file gets uploaded, an asset is created. When multiple files are selected, a batch is created.
                
                h3.header Batches 
                p Batches are a collection of assets. Technically all assets have a batch associated with them, but their functionality becomes more apparent when multiple files are uploaded.
                p If more than one file are in a batch, the assets within do not get shown in the big asset list, or in the recents list. They will still show up in searches.
                p This is mainly to avoid clutter when similarly named assets are uploaded.
                p Batches can also be turned into albums. When they are marked as an album, you can upload an album cover and add more information.

                h4.header Batch Name
                p If multiple files are uploaded, it is recommended to change the "batch name" field. This will give your batch a pretty name, instead of a randomly generated one, which is useful for albums and for searching for the batch.

                h2.header More on multiple files
                p When uploading multiple files, it is recommended to not put anything into the "name" field on the upload page. If you put in a name and upload multiple files, every fill will have that name.
                p Instead, leave it blank, and the site will automatically use the original file name to try and generate a more formatted asset name. This is useful when uploading albums, as this will display the song names for each song.

                h2.header Legal Information
                p This is a text that must be included in the video description in order to be used. This can be a simple attribution or a couple of artist links. Whatever the original copyright holder wants.

                h2.header Price
                p If you bought your asset / assets, you can add how much you paid for them. Not required, but it provides useful information. The total price you've spent on assets will be viewable on your Profile page.
            
                h2.header Source
                p If you got your asset from a website, like YouTube, please provide the source link. This will also allow for speical previews inside the asset page, like embedded YouTube videos, or song lyrics.
                
                h2.header Changes
                p You can change the information of assets and batches at any time once you've uploaded them, granted that you are the original uploaded of those files.
            .modalFooter
                button.button.has-icon(data-modal="close")
                    span.icon
                        i.fas.fa-times
                    span Close

    .container
        .buttons
            a.button(href="/assets/v/"+asset.id)
                span.icon
                    i.fas.fa-arrow-left 
                span Back
            button.button.info(data-modal="#uploadHelpModal")
                span.icon
                    i.fas.fa-info
                span Help & Information
        h1.header #{asset.name}
        p.subtitle Settings

        .message.info
            .messageHeader Quick Info
            .messageBody
                p Most of the settings can be changed here. However, some settings that are missing here, can be found in 
                    a(href="/assets/batches/settings/"+asset.batch) this asset's batch settings

        .segment
            form(action="/assets/settings/save/"+asset.id, method="post")
                .field
                    label.label(for="name") Name
                    .control.hasIcon
                        input.input#name(type="text", name="name", placeholder="Super cool asset name", maxlength="256", autocomplete="off", value=asset.name)
                        span.icon
                            i.fas.fa-heading
                    p.help Original: 
                        strong #{asset.originalName}
                        | | Generated: 
                        strong #{asset.cleanName}

                .field
                    label.label(for="aboutText") About
                    .control
                        textarea.textarea#aboutText(type="text", name="about", placeholder="About the asset...", autocomplete="off")
                            | #{asset.description.raw}

                .field
                    label.label(for="legalInfo") Legal Information
                    .control
                        textarea.textarea#legalInfo(type="text", name="legalInfo", placeholder="Required legal information about the asset", autocomplete="off")
                            | #{asset.legalInfo}

                .field 
                    label.label(for="assetType") Select an asset type
                    .control
                        select.input#assetType(name="assetType")
                            each type, i in assetTypes
                                option(value=type, selected=(asset.assetType == type)) #{formatString(type)}

                .field
                    label.label(for="tags") Tags
                    .control.hasIcon
                        input.input#tags(type="text" name="tags" placeholder="super, cool, assets", value=asset.tagsString)
                        span.icon
                            i.fas.fa-tag
                    p.help Enter tags seperated with 
                        strong ,


                .field
                    label.label(for="source") Source
                    .control.hasIcon
                        input.input#source(type="url" name="source" placeholder="https://www.youtube.com/watch?v=94vIKBfX9hI" value=asset.source) 
                        span.icon
                            i.fas.fa-globe

                .field 
                    label.label(for="licenceTypes") Licence
                    .control
                        select.input#licenceTypes(name="licence")
                            each licence, i in Object.keys(licenceTypes)
                                option(value=licence selected=(asset.licence == licence)) #{licence}
                        p.help This is completely optional. Please only choose a licence if you know that it is the correct one.

                .field
                    legend Supported Platforms
                    div.checkbox
                        input.checkbox#streaming(type="checkbox" name="streaming" checked=asset.allowedPlatforms.streams)
                        label(for="streaming") Streaming
                    div.checkbox
                        input.checkbox#videos(type="checkbox" name="videos" checked=asset.allowedPlatforms.videos)
                        label(for="videos") Videos

                .field
                    legend Is NSFW
                    div.checkbox
                        input.checkbox#nsfw(type="checkbox" name="nsfw" checked=asset.nsfw)
                        label(for="nsfw" title="Not safe for work") NSFW

                .field
                    button.button.success.fluid
                        span.icon
                            i.fas.fa-save
                        span Save

        .divider.light
        p
            small * Required

block scripts
    if !user.meta.preferences.disableMarkdown
        script.
            const easyMDE = new EasyMDE({element: document.getElementById("aboutText")});