if backendRender && backendRender === true
    include ../misc/functions.pug

if assets && assets.length > 0
    each _asset, i in assets
        tr(data-context-source="getAssetContext" data-asset=_asset.id data-owner=(user && _asset.createdBy == user.id))
            td
                -let type = getType(_asset.mimetype);
                if type == "audio"
                    button.button.iconButton.rounded(onclick="playAsset('"+_asset.id+"')")
                        i.fas.fa-play
                else if type == "video"
                    button.button.iconButton.rounded(onclick="showVideo('"+_asset.id+"')")
                        i.fas.fa-video
                else if type == "image"
                    button.button.iconButton.rounded(onclick="showImage('"+_asset.id+"')")
                        i.fas.fa-image
                button.button.iconButton.rounded(onclick="window.location = '/assets/download/"+_asset.id+"'")
                    i.fas.fa-download
            td.limited(title=(_asset.meta.hasCustomName ? _asset.name : _asset.cleanName))
                a.assetName.hiddenLink(href="/assets/v/"+_asset.id) 
                    if user && user.favorites.includes(_asset.id)
                        span.icon
                            i.fas.fa-star
                    | #{_asset.meta.hasCustomName ? _asset.name : _asset.cleanName}
                input.input.hidden.assetRename(type="text" value=(_asset.meta.hasCustomName ? _asset.name : _asset.cleanName) placeholder=_asset.name)
            td
                a(href="/users/v/"+_asset.meta.uploadedBy.safeName) #{_asset.meta.uploadedBy.username}
            //- td(title=_asset.createdAt.toLocaleString()) #{formatDate(_asset.createdAt)}
            td(title=_asset.tagsString, style="text-overflow: ellipsis;") #{_asset.tags.splice(0, 3).join(", ") || "--"} 
                if _asset.tags.length > 3
                    span ,...
else 
    p Nothing found