table.table.striped.hoverable
    thead 
        th Action
        th Name
        th Uploader
        th Date
        th Tags
    tbody
        each _asset, i in assets
            tr
                td
                    if _asset.assetType == "music" || _asset.assetType == "soundEffect"
                        button.button.iconButton.rounded(onclick="playAsset('"+_asset.id+"')")
                            i.fas.fa-play
                    else if _asset.assetType == "video"
                        button.button.iconButton.rounded(onclick="showVideo('"+_asset.id+"')")
                            i.fas.fa-video
                    else if _asset.assetType == "image"
                        button.button.iconButton.rounded(onclick="showImage('"+_asset.id+"')")
                            i.fas.fa-image
                    a.button.iconButton.rounded(href="/assets/download/"+_asset.id)
                        i.fas.fa-download
                td #{asset.name}
                td
                    a(href="/users/v/"+_asset.meta.uploadedBy.safeName) #{_asset.meta.uploadedBy.username}
                td(title=_asset.createdAt.toLocaleString()) #{formatDate(_asset.createdAt)}
                td #{asset.tagsString} 