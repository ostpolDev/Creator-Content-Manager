extends ../layout

block head
    script(src="/js/assets.js" type="module" defer) 

block content

    .container
        h1.title Assets
        p.subtitle There are currently #{asset_count.toLocaleString()} assets registered
            span(title=(asset_count > 2 ? totalSize.toLocaleString() + " B" : "")) #{asset_count > 2 ? ", totaling " + bytesToSize(totalSize) + " in size" : ""}.

        .box
            .buttons.fluid
                a.button(href="/assets/batches") 
                    span.icon
                        span folder
                    span Batches
                a.button(href="/assets/batches?type=album") 
                    span.icon
                        span album
                    span Albums
                if asset_count > 0
                    a.button(href="/assets/random")
                        span.icon
                            span shuffle
                        span View random
                    a.button(href="/assets/random?option=download")
                        span.icon
                            span download
                        span Download random
                    button.button#playRandomButton
                        span.icon
                            span play_arrow
                        span Play random

            a.button.is-fullwidth(href="/assets/add")
                span.icon
                    span add
                span Upload an asset

        hr

        h2.title.is-4#search Asset search
        p.subtitle.is-6 Search through all of the existing assets here.
        
        .columns.block
            .column
                .field
                    label.label(for="searchInput") Search
                    .control.has-icons-left
                        input.input#searchInput(type="text" placeholder="Search..." name="q" value=(search || ""), autocomplete="off")
                        span.icon.is-small.is-left
                            span search
            .column.is-2
                .field
                    label.label(for="sort") Sort by 
                    .control
                        .select.is-fullwidth
                            select#sort(autocomplete="off")
                                option(value="created_at" selected) Upload date
                                option(value="name") Name
                                option(value="size") Size
                                option(value="type") Type
            .column.is-2
                .field
                    label.label(for="order") Order 
                    .control
                        .select.is-fullwidth
                            select#order(autocomplete="off")
                                option(value="1") Ascending
                                option(value="-1" selected) Descending

        .buttons.is-justify-content-center
            button.button.iconButton.is-rounded(data-type="music") 
                span.icon
                    span music_note
            button.button.iconButton.is-rounded(data-type="soundEffect") 
                span.icon
                    span volume_up
            button.button.iconButton.is-rounded(data-type="image") 
                span.icon
                    span image
            button.button.iconButton.is-rounded(data-type="video") 
                span.icon
                    span videocam
            button.button.iconButton.is-rounded(data-type="text") 
                span.icon
                    span description
            button.button.iconButton.is-rounded(data-type="user", data-ref=user.id) 
                span.icon
                    span person
            button.button.iconButton.is-rounded(data-type="fav", data-ref=user.id) 
                span.icon
                    span star

        br
        
        table.table.is-fullwidth.is-hoverable.is-striped
            thead
                th Action
                th Name
                th Uploaded by
                th Uploaded
                th Tags
            tbody#assetList

        button.button.is-link.is-fullwidth.is-outlined#loadMoreButton
            span Load More
