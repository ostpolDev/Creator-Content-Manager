extends ../layout

block content
    .container
        h1.header Assets
        p.subtitle #{numberWithCommas(count)} assets have been uploaded so far 
            if totalSize && totalSize != -1
                span(title=totalSize) (~#{bytesToSize(totalSize)})

        .buttons.equal
            a.button(href="/assets/batches")
                span.icon
                    i.fas.fa-folder
                span Batches

            a.button(href="/assets/category/music")
                span.icon
                    i.fas.fa-file-audio
                span Music
            
            a.button(href="/assets/category/soundEffect")
                span.icon
                    i.fas.fa-file-waveform
                span Sound effects

            a.button(href="/assets/category/video")
                span.icon
                    i.fas.fa-file-video
                span Videos

            a.button(href="/assets/category/image")
                span.icon
                    i.fas.fa-file-image
                span Images

        .buttons.fluid.equal
            a.button(href="/assets/random")
                span.icon
                    i.fas.fa-shuffle
                span View Random

            a.button(href="/assets/random/download")
                span.icon
                    i.fas.fa-download
                span Download Random

            button.button(onclick="playRandomAsset()")
                span.icon
                    i.fas.fa-music
                span Play Random

            if user
                a.button(href="/assets/user/"+encodeURIComponent(user.safeName))
                    span.icon
                        i.fas.fa-user
                    span My assets
        
        .buttons.fluid
            a.button.link(href="/assets/search")
                span.icon
                    i.fas.fa-search
                span Search all assets 
            if user
                a.button.success(href="/assets/upload")
                    span.icon
                        i.fas.fa-upload
                    span Upload assets 

        .emptySpace

        h2.header Recent assets
        p.subtitle The 10 most recent assets uploaded

        table.table.striped.hoverable
            thead 
                th Action
                th Name
                th Uploader
                th Tags
            tbody
                include assetList.pug