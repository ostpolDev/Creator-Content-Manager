extends ../layout

block head
    style.
        .maxHeight {
            width: auto;
            display: block;
            margin: auto;
            max-height: 500px;
        }

block content
    .modal#confirmAssetDelete
        .modalBackground(data-modal="close")
        .modalContainer
            .modalHeader 
                h2 Are you sure?
                span.close(data-modal="close")
                    i.fas.fa-times 
            .modalContent
                p This will remove the asset named 
                    strong "#{asset.meta.hasCustomName ? asset.name : asset.cleanName}"
                    |  from this site. This cannot be undone.

                p This will also remove this assets reference from all videos that use it.
            .modalFooter
                button.button.has-icon.danger#deleteAssetButton
                    span.icon
                        i.fas.fa-trash
                    span Confirm
                button.button.has-icon(data-modal="close")
                    span.icon
                        i.fas.fa-times
                    span Cancel
    .container
        #headerContainer(data-context-source="getAssetContext" data-asset=asset.id data-owner=(user && asset.createdBy.id == user.id))
            h1.header.assetName #{asset.meta.hasCustomName ? asset.name : asset.cleanName}
            p.subtitle.capitalized #{asset.assetType}
                if asset.nsfw 
                    | 
                    span.tag.danger NSFW
            input.input.hidden.assetRename(type="text" value=(asset.meta.hasCustomName ? asset.name : asset.cleanName) placeholder=asset.name)
        .columns
            .column.threeQuarter
                -let autoplay = (user && user.meta.preferences.autoplay)
                -let type = getType(asset.mimetype);
                if type == "audio"
                    audio(controls autoplay=autoplay, controlsList="nodownload", style="width: 100%; z-index: 0; display: block;") 
                        source(src="/assets/getFile/"+asset.id, type=asset.mimetype)
                    //- audio#audioPlayer(src=, controls,  download="no")
                else if type == "video"
                    video.maxHeight(src="/assets/getFile/"+asset.id, controls, controlsList="nodownload", style="display: block; width: 100%;", autoplay=autoplay) 
                else if type == "image"
                    img.img.maxHeight(style="margin-bottom: 1em;", src="/assets/getFile/"+asset.id, alt=asset.originalName)
                else if type == "text" || asset.extention == ".md"
                    .segment.noBackground
                        pre!=replace_content(content)
                else
                    .message.info
                        .messageHeader Sorry...
                        .messageBody
                            p Assets of type "
                                strong #{type} (#{asset.extention})
                                | " cannot be displayed. They can still be downloaded and used in videos.

                if asset.description.rendered
                    br
                    .segment.closed
                        pre!=asset.description.rendered.trim()

                if asset.legalInfo
                    h2.header Legal Information
                    p.subtitle Include this in your description to not get in trouble with the copyright holder.
                    .segment
                        pre!=replace_content(asset.legalInfo.trim())

                .specialContainer
                    if asset.source && asset.source.includes("youtube.com/watch?v=")
                        br
                        -let id = asset.source.split(/[\=\&]/g)[1]
                        iframe.youtubeFrame(width="560" height="315" src="https://www.youtube.com/embed/"+encodeURIComponent(id) title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen)

                if asset.licence && asset.licence != "None"
                    -let licence = licenceTypes[asset.licence]
                    h2.header Licence
                    a.user.tiny.noBorder(href=licence.url target="_BLANK")
                        .image.auto
                            img(src=licence.icon, alt=asset.licence)
                        .content
                            h1.header #{asset.licence}
                if user && channel && !user.meta.preferences.hideAssetVideoList
                    .divider.light
                    h2.header Videos
                    p.subtitle Videos of yours that use this asset
                    #sortContainer
                        .field 
                            label.label(for="channelSelect") Sort by
                            .control
                                select.input.capitalized#sortSelect
                                    each sort, i in Object.keys(sorts)
                                        option.capitalized(value=sort,selected=(sort == "upload date"))=sort

                        .field 
                            label.label(for="channelSelect") Order
                            .control
                                select.input#orderSelect
                                    option(value=1) Acending
                                    option(value=-1 selected) Decending

                        .field
                            label.label(for="searchQuery") Search Query
                            .control.hasIcon
                                input.input#searchQuery(type="url" name="searchQuery" placeholder="Title, description, tags, ...") 
                                span.icon
                                    i.fas.fa-search

                        .field
                            .buttons.equal
                                button.button.fluid#clearButton
                                    span.icon
                                        i.fas.fa-trash
                                    span Clear Filter
                                button.button.fluid#searchButton
                                    span.icon
                                        i.fas.fa-search
                                    span Search

                        .divider.light

                    .columns.multiline#videoGridContainer

                    button.button.link.fluid.hidden#loadMoreButton
                        span.icon
                            i.fas.fa-plus
                        span Load More

            .column
                if asset.batch.isAlbum
                    a.card.hoverable(href="/assets/batches/v/"+asset.batch.id)
                        if asset.batch.cover.hasCover
                            .cardImage
                                img(src="/assets/batches/cover/"+asset.batch.id, alt=asset.batch.name, loading="lazy") 
                        .cardBody
                            -
                                let title = asset.batch.name;
                                let splits = asset.batch.name.split("-");
                                let artist = asset.batch.artist;
                                if (!artist && splits.length > 1) {
                                    artist = splits[1];

                                    title = splits[0];
                                }
                            h1.header #{title}
                            p #{artist}
                    .emptySpace
                if asset.batch.purchase.isPurchased
                    .tags
                        span.tag.warning(title="This asset was purchased")
                            span.icon
                                i.fas.fa-euro-sign
                            span #{asset.batch.purchase.price.toFixed(2)}
                .buttons.fluid
                    a.button.success(href="/assets/download/"+asset.id)
                        span.icon
                            i.fas.fa-download
                        span Download
                    if asset.source
                        a.button(href=asset.source target="_BLANK" data-hover=asset.source)
                            span.icon
                                i.fas.fa-globe 
                            span View source 
                    if asset.batchSize > 1
                        a.button(href="/assets/batches/v/"+asset.batch.id) 
                            span.icon
                                i.fas.fa-folder
                            span View Batch
                    if user
                        -let _index = user.favorites.indexOf(asset.id);
                        button.button.warning#removeFavButton(class=(_index == -1 ? "hidden" : ""), onclick="manageFav('remove', '"+asset.id+"')")
                            span.icon
                                i.fas.fa-star

                        button.button#addFavButton(class=(_index != -1 ? "hidden" : ""), onclick="manageFav('add', '"+asset.id+"')")
                            span.icon
                                i.far.fa-star
                        if user.id == asset.createdBy.id
                            a.button(href="/assets/settings/"+asset.id) 
                                span.icon
                                    i.fas.fa-cog
                                span Settings 
                            button.button.danger(data-modal="#confirmAssetDelete")
                                span.icon
                                    i.fas.fa-trash
                                span Delete Asset

                a.user.small.fluid(href="/users/v/"+asset.createdBy.safeName)
                    .image
                        img.rounded(src="https://www.gravatar.com/avatar/"+asset.createdBy.mailHash, alt=asset.createdBy.username)
                    .content
                        h1.header #{asset.createdBy.username}
                        p Creator of this asset

                .segment
                    p
                        b Uploaded at:
                        br
                        span(title=asset.createdAt.toLocaleString()) #{formatDateAndTime(asset.createdAt)} 
                    p
                        b Updated at:
                        br
                        span(title=asset.updatedAt.toLocaleString()) #{formatDateAndTime(asset.updatedAt)} 
                    p
                        b Extention:
                        br
                        span #{asset.extention} 
                    p
                        b Type:
                        br
                        span #{asset.mimetype} 
                    p
                        b Downloads:
                        br
                        span(title=asset.meta.downloads || 0) #{numberWithCommas(asset.meta.downloads || 0)} 
                    p
                        b Favorites:
                        br
                        span #{favoriteCount} 
                    p
                        b Size:
                        br
                        span(title=asset.size) #{bytesToSize(asset.size)} 
                    p
                        b Batch Size:
                        br
                        a.hiddenLink(href="/assets/batches/v/"+asset.batch.id)  #{asset.batchSize} 
                    p
                        b Original Name:
                        br
                        span #{asset.originalName} 
                    if dbMeta
                        p
                            b Meta ID: 
                            br
                            a.hiddenLink(href="/meta/v/"+dbMeta.id+"?from="+asset.id+"&type=assets") #{dbMeta.id}

                if asset.tags
                    .tags 
                        each tag, i in asset.tags
                            span.tag=tag


                .buttons.fluid
                    if asset.allowedPlatforms.videos === true
                        button.button.success
                            span.icon
                                i.fab.fa-youtube
                            span Can be used for videos
                    else
                        button.button.danger
                            span.icon
                                i.fab.fa-youtube
                            span 
                                strong Cannot
                                |  be used for videos

                    if asset.allowedPlatforms.streams === true
                        button.button.success
                            span.icon
                                i.fab.fa-twitch
                            span Can be used for streams
                    else
                        button.button.danger
                            span.icon
                                i.fab.fa-twitch
                            span 
                                strong Cannot
                                |  be used for streams

block scripts
    script.
        const assetId = "#{asset.id}";
    
    script(src="/js/asset.js")
    if user && channel && !user.meta.preferences.hideAssetVideoList
        script(src="/js/assetVideos.js") 