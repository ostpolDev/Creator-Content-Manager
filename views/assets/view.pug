extends ../layout

block head
    script.
        const DEF = {
            asset: "#{asset.id}",
            batch: "#{asset.batch}",
            mime: "#{asset.mime}",
        }

    script(src="/js/assets/view.js" type="module" defer) 

    if view == "references"
        link(rel="stylesheet", href="/bulma/bulma-list.css")

        if asset.added_by == user.id
            script(src="/js/assets/references.js" type="module" defer) 

block modals
    if isAuthor
        .modal#deleteModal
            .modal-background(data-modal="close")
            .modal-card
                header.modal-card-head
                    p.modal-card-title Are you sure?
                    button.delete(data-modal="close")
                section.modal-card-body
                    p Deleting 
                        strong "#{asset.name}" 
                        | cannot be undone and will delete the files and all of the content associated with this asset.
                footer.modal-card-foot
                    .buttons
                        button.button(data-modal="close")
                            span.icon
                                span close
                            span Cancel
                        button.button.is-danger.is-outlined#confirmDeleteButton
                            span.icon
                                span delete
                            span Delete forever

    include ../modals/playlistAdd.pug

block content
    .container

        nav.breadcrumb.has-succeeds-separator
            ul
                li
                    a(href="/assets") Assets
                if channel
                    li
                        a(href="/resources") Resources
                    if channel != "GLOBAL" 
                        li
                            a(href="/resources?channel=" + encodeURIComponent(channel.id)) #{channel.name} 
                li.is-active
                    a(href="#") #{asset.name}

        .columns
            .column.is-two-quarters
                h1.title #{asset.name}
                p.subtitle #{formatString(asset.type)}

                if channel
                    .message.is-info
                        .message-body
                            if channel == "GLOBAL"
                                p This asset is a 
                                    a(href="/resources") global resource.
                            else
                                p This asset is a resource for the 
                                    a(href="/resources?channel=" + encodeURIComponent(channel.id)) #{channel.name} channel.  

                if asset.type == "music" || asset.type == "soundEffect"
                    audio(src=("/assets/get/" + asset.id), controls, style="display: block; width: 100%;") 
                else if asset.type == "image"
                    a.block(href="/assets/get/" + asset.id, style="display: block;") 
                        img.assetImage(src="/assets/get/" + asset.id, alt=asset.name)
                else if asset.type == "video"
                    video(src="/assets/get/" + asset.id, controls, style="display: block; max-height: 25dvh; margin-inline: auto; max-width: 100%;") 
                else if asset.type == "text"
                    .content
                        button.button.is-fullwidth.is-loading#placeholderButton Loading...

                br

                if asset.legal_information
                    .message.is-light.block
                        .message-header Legal information
                        .message-body
                            pre.noBackground #{asset.legal_information}

                if asset.license && licenseTypes[asset.license] && asset.license != "None"
                    -let license = licenseTypes[asset.license];

                    .block.box
                        article.media
                            figure.media-left
                                p.image.is-64x64.centered
                                    img(src=license.icon)
                            .media-content
                                if license.msg
                                    p #{license.msg}
                                if license.url
                                    p
                                        a(href=license.url) More information 
                                
                
                if asset.rendered_description
                    pre.noBackground
                        .content!=asset.rendered_description
                    br

                .tags
                    if asset.nsfw
                        .tag.is-danger NSFW
                    if !asset.videos
                        .tag.is-danger NOT for YouTube
                    if !asset.streams
                        .tag.is-danger NOT for Twitch & Streams
                    if asset.price
                        .tag.is-warning $#{asset.price}
                    if asset.tags
                        each tag in asset.tags.split(",")
                            span.tag 
                                a.hiddenLink(href="/assets?q=" + encodeURIComponent(tag)) #{tag.trim()}

                .tabs.is-boxed#tabs
                    ul
                        li(class=(view == "videos" ? "is-active" : ""))
                            a(href="?view=videos#tabs")
                                span.icon.is-small
                                    span videocam
                                span Videos
                        li(class=(view == "comments" ? "is-active" : ""))
                            a(href="?view=comments#tabs")
                                span.icon.is-small
                                    span comment
                                span Comments#{commentCount > 0 ? ` (${commentCount.toLocaleString()})` : ""}
                        li(class=(view == "references" ? "is-active" : ""))
                            a(href="?view=references#tabs")
                                span.icon.is-small
                                    span attach_file
                                span References

                if view == "comments"

                    div(data-comment=("A:" + asset.id))
                
                else if view == "videos"

                    .block
                        .columns
                            .column.is-one-quarter
                                .field
                                    label.label(for="channelSearch") Channel
                                    .control
                                        .select.is-fullwidth
                                            select.input.channelSelect#channelSearch(autocomplete="off", data-list-target="videos", data-list-filter="channel")
                                                option(value="") Any
                                                each channel in channels
                                                    option(value=channel.id) #{channel.name} 
                            .column
                                .field
                                    label.label Search
                                    .control.has-icons-left
                                        input.input#searchInput(type="text" placeholder="Search..." name="q", data-list-target="videos", data-list-filter="q")
                                        span.icon.is-small.is-left
                                            span search

                    .columns.is-multiline(data-list="videos", data-list-load="true", data-list-filter="asset:" + asset.id, data-list-size="one-quarter")

                else if view == "references"

                    if asset.added_by == user.id
                        .field.block
                            label.label Asset search
                            .control.has-icons-left
                                input.input#searchInput(type="text" placeholder="Search for an asset" autocomple="off" value="")
                                span.icon.is-small.is-left
                                    span search

                        .columns
                            .column.is-half
                                h2.title.is-6 Referenced assets
                                button.button.is-fullwidth.is-loading#loadingCurrent Loading
                                .list.has-visible-pointer-controls.has-overflow-ellipsis#currentAssetsContainer
                                
                            .column.is-half
                                h2.title.is-6 Search Results
                                button.button.is-fullwidth.is-loading.is-hidden#loadingSearch Loading
                                .list.has-visible-pointer-controls.has-overflow-ellipsis#searchedAssetsContainer

                    else

                        .field
                            label.label Search
                            .control.has-icons-left
                                input.input#searchInput(type="text" placeholder="Search..." name="q", data-list-target="assets", data-list-filter="q")
                                span.icon.is-small.is-left
                                    span search

                        table.table.is-fullwidth.is-striped.is-hoverable
                            thead
                                th Action
                                th Name
                                th Author
                                th Uploaded
                                th Tags
                            tbody(data-list="assets" data-list-filter=(`reference:${asset.id}`), data-list-load="true")

            .column.is-one-quarter
                .is-position-sticky(style="height: fit-content; top: 10px;")
                    .buttons
                        if isAuthor
                            a.button.iconButton.is-rounded(href="/assets/edit/" + asset.id) 
                                span.icon
                                    span edit
                        a.button.iconButton.is-rounded(href="/assets/download/" + asset.id) 
                            span.icon
                                span download
                        button.button.is-loading.is-rounded.iconButton#likeButton
                            span.icon
                                span star
                        if asset.source
                            a.button.iconButton.is-rounded(href=asset.source, title=asset.source)
                                span.icon
                                    span link 
                        button.button.iconButton.is-rounded#playlistButton
                            span.icon
                                span playlist_add
                        if isAuthor
                            button.button.iconButton.is-rounded.is-danger.is-outlined#deleteButton
                                span.icon
                                    span delete

                    .box.content
                        p
                            strong Uploaded by
                            br
                            a.ellipsed(href="/users/v/" + asset.author_username) #{asset.author_display_name} 
                        p
                            strong Upload date
                            br
                            time(datetime=asset.created_at, data-format="smart")
                        if asset.created_at.getTime() != asset.updated_at.getTime()
                            p
                                strong Last change
                                br
                                time(datetime=asset.updated_at, data-format="smart")
                        p
                            strong Size
                            br
                            span(title=asset.size.toLocaleString() + " B") #{bytesToSize(asset.size)}
                        p
                            strong Extension
                            br
                            | #{asset.extension}
                        p
                            strong Type
                            br
                            | #{asset.mime}
                        p
                            strong Batch
                            br
                            a.ellipsed(href="/assets/batches/v/" + asset.batch, title=asset.batch) #{asset.batch_name || asset.batch}
                        p
                            strong Original name
                            br
                            span.ellipsed(title=asset.original_name) #{asset.original_name}
                        p
                            strong Favorites
                            br
                            span #{asset.favorites.toLocaleString()}
                        p
                            strong Downloads
                            br
                            span #{asset.downloads.toLocaleString()}
                        if downloadCount > 0
                            p
                                strong Downloaded by you
                                br
                                span #{downloadCount.toLocaleString()}
                        p
                            strong ID
                            br
                            span.ellipsed(title=asset.id) #{asset.id}
