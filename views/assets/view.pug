extends ../layout

block head
    style.
        .maxHeight {
            width: 100%;
            display: block;
            margin: auto;
            max-height: 500px;
        }

block content
    .modal#confirmAssetDelete
        .modalBackground(data-modal="close")
        .modalContainer
            .modalHeader 
                h2 Are you sure?
                span.close(data-modal="close")
                    i.fas.fa-times 
            .modalContent
                p This will remove the asset named 
                    strong "#{asset.meta.hasCustomName ? asset.name : asset.cleanName}"
                    |  from this site. This cannot be undone.

                p This will also remove this assets reference from all videos that use it.
            .modalFooter
                button.button.has-icon.danger#deleteAssetButton
                    span.icon
                        i.fas.fa-trash
                    span Confirm
                button.button.has-icon(data-modal="close")
                    span.icon
                        i.fas.fa-times
                    span Cancel
    .container
        #headerContainer(data-context-source="getAssetContext" data-asset=asset.id data-owner=(user && asset.createdBy.id == user.id).toString())
            h1.header.assetName #{asset.meta.hasCustomName ? asset.name : asset.cleanName}
            p.subtitle.capitalized #{asset.assetType}
            input.input.hidden.assetRename(type="text" value=(asset.meta.hasCustomName ? asset.name : asset.cleanName) placeholder=asset.name)
        .columns
            .column.threeQuarter
                -let type = getType(asset.mimetype);
                if type == "audio"
                    audio#audioPlayer(src="/assets/getFile/"+asset.id, controls, controlsList="nodownload", style="width: 100%; z-index: 0; display: block;" download="no")
                else if type == "video"
                    video.maxHeight(src="/assets/getFile/"+asset.id, controls, controlsList="nodownload", style="display: block; width: 100%;") 
                else if type == "image"
                    img.img.maxHeight(style="display: block; width: 100%; margin-bottom: 1em;", src="/assets/getFile/"+asset.id, alt=asset.originalName)

                if asset.description.rendered
                    br
                    .segment
                        pre!=asset.description.rendered.trim()

                if asset.legalInfo
                    h2.header Legal Information
                    p.subtitle Include this in your description to not get in trouble with the copyright holder.
                    .segment
                        pre!=replace_content(asset.legalInfo.trim())

                if asset.licence && asset.licence != "None"
                    -let licence = licenceTypes[asset.licence]
                    h2.header Licence
                    a.user.tiny.noBorder(href=licence.url target="_BLANK")
                        .image.auto
                            img(src=licence.icon, alt=asset.licence)
                        .content
                            h1.header #{asset.licence}

            .column
                if asset.purchase.isPurchased
                    .tags
                        span.tag.warning(title="This asset was purchased")
                            span.icon
                                i.fas.fa-money-bill
                            span #{asset.purchase.price}
                .buttons.fluid
                    a.button.success(href="/assets/download/"+asset.id)
                        span.icon
                            i.fas.fa-download
                        span Download
                    if asset.source
                        a.button(href=asset.source target="_BLANK")
                            span.icon
                                i.fas.fa-globe 
                            span View source 
                    if asset.batchSize > 1
                        a.button(href="/assets/batches/v/"+asset.batch) 
                            span.icon
                                i.fas.fa-folder
                            span View Batch
                    if user
                        if user.id == asset.createdBy.id
                            a.button(href="/assets/settings/"+asset.id) 
                                span.icon
                                    i.fas.fa-cog
                                span Settings 
                            button.button.danger(data-modal="#confirmAssetDelete")
                                span.icon
                                    i.fas.fa-trash
                                span Delete Asset
                        -let _index = user.favorites.indexOf(asset.id);
                        button.button.warning#removeFavButton(class=(_index == -1 ? "hidden" : ""), onclick="manageFav('remove', '"+asset.id+"')")
                            span.icon
                                i.fas.fa-star

                        button.button#addFavButton(class=(_index != -1 ? "hidden" : ""), onclick="manageFav('add', '"+asset.id+"')")
                            span.icon
                                i.far.fa-star

                a.user.small.fluid(href="/users/v/"+asset.createdBy.safeName)
                    .image
                        img.rounded(src="https://www.gravatar.com/avatar/"+asset.createdBy.mailHash, alt=asset.createdBy.username)
                    .content
                        h1.header #{asset.createdBy.username}
                        p Creator of this asset

                .segment
                    p
                        b Uploaded at:
                        br
                        span(title=asset.createdAt.toLocaleString()) #{formatDate(asset.createdAt)} 
                    p
                        b Updated at:
                        br
                        span(title=asset.updatedAt.toLocaleString()) #{formatDate(asset.updatedAt)} 
                    p
                        b Extention:
                        br
                        span #{asset.extention} 
                    p
                        b Type:
                        br
                        span #{asset.mimetype} 
                    p
                        b Downloads:
                        br
                        span(title=asset.meta.downloads || 0) #{numberWithCommas(asset.meta.downloads || 0)} 
                    p
                        b Favorites:
                        br
                        span #{favoriteCount} 
                    p
                        b Size:
                        br
                        span(title=asset.size) #{bytesToSize(asset.size)} 
                    p
                        b Batch Size:
                        br
                        a.hiddenLink(href="/assets/batches/v/"+asset.batch)  #{asset.batchSize} 
                    p
                        b Original Name:
                        br
                        span #{asset.originalName} 


                .buttons.fluid
                    if asset.allowedPlatforms.videos === true
                        button.button.success
                            span.icon
                                i.fab.fa-youtube
                            span Can be used for videos
                    else
                        button.button.danger
                            span.icon
                                i.fab.fa-youtube
                            span 
                                strong Cannot
                                |  be used for videos

                    if asset.allowedPlatforms.streams === true
                        button.button.success
                            span.icon
                                i.fab.fa-twitch
                            span Can be used for streams
                    else
                        button.button.danger
                            span.icon
                                i.fab.fa-twitch
                            span 
                                strong Cannot
                                |  be used for streams

block scripts
    script.
        const assetId = "#{asset.id}";
    
    script(src="/js/asset.js")