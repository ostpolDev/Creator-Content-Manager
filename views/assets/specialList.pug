extends ../layout

block content
    .container
        h1.title(class=(capitalized ? "capitalized" : "")) #{title}

        .message.danger.hidden#invalidMessage
            .messageHeader Something went wrong
            .messageBody
                p The currently selected type of search is not available.

        a.user.small.fluid.hidden#userElement
            .image
                img.rounded#userElementImage
            .content
                h1.header#userElementName

        #searchContainer
            .field 
                label.label(for="sortSelect") Sort by
                .control
                    select.input.capitalized#sortSelect
                        each sort, i in Object.keys(sorts)
                            option.capitalized(value=sort,selected=(sort == "name date"))=sort

            .field 
                label.label(for="channelSelect") Order
                .control
                    select.input#orderSelect
                        option(value=1) Acending
                        option(value=-1 selected) Decending

            .field 
                label.label(for="channelSelect") Extention
                .control
                    select.input#extentionSelect
                        option(value="null") Any
                        each fileType, i in fileTypes
                            option(value=fileType) #{fileType}

            .field
                label.label(for="searchQuery") Search Query
                .control.hasIcon
                    input.input#searchQuery(type="url" name="searchQuery" placeholder="Title, description, tags, ...") 
                    span.icon
                        i.fas.fa-search

            .field
                .buttons.equal
                    button.button.fluid#clearButton
                        span.icon
                            i.fas.fa-trash
                        span Clear Filter
                    button.button.fluid#searchButton
                        span.icon
                            i.fas.fa-search
                        span Search

            .divider

            table.table.striped.hoverable
                thead 
                    th Action
                    th Name
                    th Uploader
                    th Tags
                tbody#assetTableBody

            button.button.link.fluid.hidden#loadMoreButton
                span.icon
                    i.fas.fa-plus
                span Load More

block scripts
    script.
        const type = "#{type}";
        const userName = "#{userName}";
        const assetType = "#{assetType}";

    script(src="/js/specialAssetList.js") 