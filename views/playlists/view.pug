extends ../layout

block head
    script.
        const DEF = {
            playlist: "#{playlist.id}",
        }
    if view == "assets"
        script(src="/js/assets.js" type="module" defer) 

block content
    .container

        nav.breadcrumb.has-succeeds-separator
            ul
                li
                    a(href="/assets") Assets
                li
                    a(href="/assets/playlists") Playlists
                li.is-active
                    a(href="#") #{playlist.title}

        .columns
            .column.is-three-quarters
                h1.title #{playlist.title}
                p.subtitle #{assetCount.toLocaleString()} asset#{assetCount == 1 ? '' : 's'}

                .buttons.block
                    if canAdd
                        button.button#addAssetsButton
                            span.icon
                                span library_add
                            span Add assets

                if playlist.rendered_description
                    .content.block
                        p!=playlist.rendered_description

                    br

                if isAuthor
                    .tabs.is-boxed#tabs
                        ul
                            li(class=(view == "assets" ? "is-active" : ""))
                                a(href="?view=assets#tabs")
                                    span.icon.is-small
                                        span files
                                    span Assets
                            li(class=(view == "members" ? "is-active" : ""))
                                a(href="?view=members#tabs")
                                    span.icon.is-small
                                        span people
                                    span Members

                if view == "assets" || !isAuthor
                    .columns.block
                        .column
                            .field
                                label.label(for="searchInput") Search
                                .control.has-icons-left
                                    input.input#searchInput(type="text" placeholder="Search..." name="q" value=(search || ""), autocomplete="off")
                                    span.icon.is-small.is-left
                                        span search
                        .column.is-3
                            .field
                                label.label(for="sort") Sort by 
                                .control
                                    .select.is-fullwidth
                                        select#sort(autocomplete="off")
                                            option(value="created_at" selected) Upload date
                                            option(value="name") Name
                                            option(value="size") Size
                                            option(value="type") Type
                        .column.is-3
                            .field
                                label.label(for="order") Order 
                                .control
                                    .select.is-fullwidth
                                        select#order(autocomplete="off")
                                            option(value="1") Ascending
                                            option(value="-1" selected) Descending
                    table.table.is-fullwidth.is-striped.is-hoverable
                        thead
                            th Action
                            th Name
                            th Author
                            th Uploaded
                            th Tags
                        tbody#assetList(data-filter="playlist:" + playlist.id)

                    button.button.is-link.is-fullwidth.is-outlined#loadMoreButton
                        span Load More

                else if view == "members" && isAuthor


            .column.is-one-quarter
                .is-position-sticky(style="height: fit-content; top: 10px;")
                    .buttons
                        if isAuthor
                            a.button.iconButton.is-rounded(href="/assets/playlists/edit/" + playlist.id) 
                                span.icon
                                    span edit
                        if canAdd
                            button.button.iconButton.is-rounded#secondAddAssetsButton
                                span.icon
                                    span library_add
                        if isAuthor
                            button.button.iconButton.is-rounded.is-danger.is-outlined#deleteButton
                                span.icon
                                    span delete

                    .box.content
                        p
                            strong Created by
                            br
                            a.ellipsed(href="/users/v/" + playlist.author_username) #{playlist.author_display_name}
                        p
                            strong Creation date
                            br
                            time(datetime=playlist.created_at, data-format="smart")
                        p
                            strong Assets
                            br
                            span #{assetCount.toLocaleString()}
                        p
                            strong Public
                            br
                            span #{playlist.public}
                        p
                            strong ID
                            br
                            span.ellipsed #{playlist.id}
    
